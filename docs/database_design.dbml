Enum "estado_usuario" {
  "activo"
  "inactivo"
  "bloqueado"
}

Enum "estado_general" {
  "activo"
  "inactivo"
  "archivado"
}

Enum "estado_persona_academica" {
  "activo"
  "inactivo"
  "graduado"
  "suspendido"
  "retirado"
}

Enum "estado_periodo" {
  "planificado"
  "activo"
  "cerrado"
  "archivado"
}

Enum "estado_paralelo" {
  "planificado"
  "abierto"
  "cerrado"
  "cancelado"
  "completado"
}

Enum "estado_matricula" {
  "borrador"
  "pendiente"
  "aprobado"
  "rechazado"
  "cancelado"
}

Enum "estado_asignatura_matricula" {
  "matriculado"
  "retirado"
  "completado"
  "aprobado"
  "reprobado"
}

Enum "tipo_solicitud" {
  "aprobacion_matricula"
  "retiro"
  "cambio_paralelo"
  "revision_calificacion"
  "actualizacion_documento"
  "certificado_academico"
  "otro"
}

Enum "estado_solicitud" {
  "pendiente"
  "en_revision"
  "aprobado"
  "rechazado"
  "cancelado"
}

Enum "estado_asistencia" {
  "presente"
  "ausente"
  "atraso"
  "justificado"
}

Enum "estado_notificacion" {
  "no_leido"
  "leido"
}

Enum "estado_documento" {
  "pendiente"
  "aprobado"
  "rechazado"
}

Enum "modalidad_asignatura" {
  "presencial"
  "virtual"
  "hibrida"
}

Enum "nivel_programa" {
  "pregrado"
  "posgrado"
}

Table "usuarios" {
  "usuario_id" UUID [pk, default: `gen_random_uuid()`]
  "nombre_completo" VARCHAR(150) [not null]
  "correo_electronico" VARCHAR(255) [unique, not null]
  "clave_hash" VARCHAR(255) [not null]
  "telefono" VARCHAR(30)
  "avatar_url" TEXT
  "estado" estado_usuario [not null, default: 'activo']
  "ultimo_ingreso_at" TIMESTAMP
  "creado_at" TIMESTAMP [not null, default: `NOW()`]
  "actualizado_at" TIMESTAMP [not null, default: `NOW()`]

  Indexes {
    correo_electronico [name: "idx_usuarios_correo"]
    estado [name: "idx_usuarios_estado"]
  }
}

Table "roles" {
  "rol_id" UUID [pk, default: `gen_random_uuid()`]
  "nombre" VARCHAR(50) [unique, not null]
  "descripcion" TEXT
  "creado_at" TIMESTAMP [not null, default: `NOW()`]
  "actualizado_at" TIMESTAMP [not null, default: `NOW()`]
}

Table "permisos" {
  "permiso_id" UUID [pk, default: `gen_random_uuid()`]
  "codigo" VARCHAR(100) [unique, not null]
  "descripcion" TEXT
  "creado_at" TIMESTAMP [not null, default: `NOW()`]
  "actualizado_at" TIMESTAMP [not null, default: `NOW()`]
}

Table "usuario_roles" {
  "usuario_id" UUID [not null]
  "rol_id" UUID [not null]
  "asignado_at" TIMESTAMP [not null, default: `NOW()`]

  Indexes {
    (usuario_id, rol_id) [pk]
  }
}

Table "rol_permisos" {
  "rol_id" UUID [not null]
  "permiso_id" UUID [not null]
  "asignado_at" TIMESTAMP [not null, default: `NOW()`]

  Indexes {
    (rol_id, permiso_id) [pk]
  }
}

Table "facultades" {
  "facultad_id" UUID [pk, default: `gen_random_uuid()`]
  "codigo" VARCHAR(30) [unique, not null]
  "nombre" VARCHAR(150) [not null]
  "descripcion" TEXT
  "estado" estado_general [not null, default: 'activo']
  "creado_at" TIMESTAMP [not null, default: `NOW()`]
  "actualizado_at" TIMESTAMP [not null, default: `NOW()`]
}

Table "carreras" {
  "carrera_id" UUID [pk, default: `gen_random_uuid()`]
  "facultad_id" UUID [not null]
  "codigo" VARCHAR(30) [unique, not null]
  "nombre" VARCHAR(150) [not null]
  "titulo_otorgado" VARCHAR(150)
  "duracion_semestres" INT [not null]
  "nivel_academico" nivel_programa [not null, default: 'pregrado']
  "estado" estado_general [not null, default: 'activo']
  "creado_at" TIMESTAMP [not null, default: `NOW()`]
  "actualizado_at" TIMESTAMP [not null, default: `NOW()`]

  Indexes {
    facultad_id [name: "idx_carreras_facultad"]
    nivel_academico [name: "idx_carreras_nivel"]
  }
}

Table "mallas_curriculares" {
  "malla_id" UUID [pk, default: `gen_random_uuid()`]
  "carrera_id" UUID [not null]
  "version" VARCHAR(50) [not null]
  "nombre" VARCHAR(150) [not null]
  "anio_inicio" INT
  "estado" estado_general [not null, default: 'activo']
  "creado_at" TIMESTAMP [not null, default: `NOW()`]
  "actualizado_at" TIMESTAMP [not null, default: `NOW()`]

  Indexes {
    (carrera_id, version) [unique, name: "uq_malla_carrera_version"]
    carrera_id [name: "idx_mallas_carrera"]
  }
}

Table "asignaturas" {
  "asignatura_id" UUID [pk, default: `gen_random_uuid()`]
  "codigo" VARCHAR(30) [unique, not null]
  "nombre" VARCHAR(150) [not null]
  "descripcion" TEXT
  "creditos" INT [not null, default: 0]
  "horas_teoria" INT [not null, default: 0]
  "horas_practica" INT [not null, default: 0]
  "estado" estado_general [not null, default: 'activo']
  "creado_at" TIMESTAMP [not null, default: `NOW()`]
  "actualizado_at" TIMESTAMP [not null, default: `NOW()`]

  Indexes {
    codigo [name: "idx_asignaturas_codigo"]
  }
}

Table "malla_asignaturas" {
  "malla_asignatura_id" UUID [pk, default: `gen_random_uuid()`]
  "malla_id" UUID [not null]
  "asignatura_id" UUID [not null]
  "numero_semestre" INT [not null]
  "es_obligatoria" BOOLEAN [not null, default: true]
  "creado_at" TIMESTAMP [not null, default: `NOW()`]

  Indexes {
    (malla_id, asignatura_id) [unique, name: "uq_malla_asignatura"]
    malla_id [name: "idx_malla_asignaturas_malla"]
    asignatura_id [name: "idx_malla_asignaturas_asignatura"]
  }
}

Table "prerrequisitos_asignaturas" {
  "asignatura_id" UUID [not null]
  "asignatura_prerrequisito_id" UUID [not null]

  Indexes {
    (asignatura_id, asignatura_prerrequisito_id) [pk]
  }
}

Table "estudiantes" {
  "estudiante_id" UUID [pk, default: `gen_random_uuid()`]
  "usuario_id" UUID [unique, not null]
  "carrera_id" UUID [not null]
  "malla_id" UUID
  "codigo_estudiante" VARCHAR(50) [unique, not null]
  "numero_documento" VARCHAR(50) [unique]
  "fecha_nacimiento" DATE
  "direccion" VARCHAR(255)
  "telefono" VARCHAR(30)
  "fecha_admision" DATE
  "semestre_actual" INT [default: 1]
  "estado" estado_persona_academica [not null, default: 'activo']
  "creado_at" TIMESTAMP [not null, default: `NOW()`]
  "actualizado_at" TIMESTAMP [not null, default: `NOW()`]

  Indexes {
    usuario_id [name: "idx_estudiantes_usuario"]
    carrera_id [name: "idx_estudiantes_carrera"]
    estado [name: "idx_estudiantes_estado"]
  }
}

Table "docentes" {
  "docente_id" UUID [pk, default: `gen_random_uuid()`]
  "usuario_id" UUID [unique, not null]
  "facultad_id" UUID
  "codigo_docente" VARCHAR(50) [unique, not null]
  "numero_documento" VARCHAR(50) [unique]
  "especialidad" VARCHAR(150)
  "titulo_academico" VARCHAR(150)
  "fecha_contratacion" DATE
  "estado" estado_general [not null, default: 'activo']
  "creado_at" TIMESTAMP [not null, default: `NOW()`]
  "actualizado_at" TIMESTAMP [not null, default: `NOW()`]

  Indexes {
    usuario_id [name: "idx_docentes_usuario"]
    facultad_id [name: "idx_docentes_facultad"]
  }
}

Table "personal_administrativo" {
  "personal_id" UUID [pk, default: `gen_random_uuid()`]
  "usuario_id" UUID [unique, not null]
  "codigo_personal" VARCHAR(50) [unique, not null]
  "nombre_departamento" VARCHAR(150)
  "cargo" VARCHAR(150)
  "estado" estado_general [not null, default: 'activo']
  "creado_at" TIMESTAMP [not null, default: `NOW()`]
  "actualizado_at" TIMESTAMP [not null, default: `NOW()`]
}

Table "periodos_academicos" {
  "periodo_academico_id" UUID [pk, default: `gen_random_uuid()`]
  "codigo" VARCHAR(50) [unique, not null]
  "nombre" VARCHAR(150) [not null]
  "fecha_inicio" DATE [not null]
  "fecha_fin" DATE [not null]
  "fecha_inicio_matriculacion" DATE
  "fecha_fin_matriculacion" DATE
  "fecha_inicio_calificaciones" DATE
  "fecha_fin_calificaciones" DATE
  "estado" estado_periodo [not null, default: 'planificado']
  "creado_at" TIMESTAMP [not null, default: `NOW()`]
  "actualizado_at" TIMESTAMP [not null, default: `NOW()`]
}

Table "aulas" {
  "aula_id" UUID [pk, default: `gen_random_uuid()`]
  "codigo" VARCHAR(50) [unique, not null]
  "nombre" VARCHAR(100)
  "capacidad" INT [not null, default: 0]
  "ubicacion" VARCHAR(150)
  "estado" estado_general [not null, default: 'activo']
  "creado_at" TIMESTAMP [not null, default: `NOW()`]
  "actualizado_at" TIMESTAMP [not null, default: `NOW()`]
}

Table "paralelos" {
  "paralelo_id" UUID [pk, default: `gen_random_uuid()`]
  "asignatura_id" UUID [not null]
  "periodo_academico_id" UUID [not null]
  "docente_id" UUID
  "codigo_paralelo" VARCHAR(30) [not null]
  "modalidad" modalidad_asignatura [not null, default: 'presencial']
  "capacidad" INT [not null]
  "cantidad_matriculados" INT [not null, default: 0]
  "enlace_virtual" TEXT
  "estado" estado_paralelo [not null, default: 'planificado']
  "creado_at" TIMESTAMP [not null, default: `NOW()`]
  "actualizado_at" TIMESTAMP [not null, default: `NOW()`]

  Indexes {
    (asignatura_id, periodo_academico_id, codigo_paralelo) [unique, name: "uq_asignatura_paralelo_periodo"]
    asignatura_id [name: "idx_paralelos_asignatura"]
    periodo_academico_id [name: "idx_paralelos_periodo"]
    docente_id [name: "idx_paralelos_docente"]
    estado [name: "idx_paralelos_estado"]
  }
}

Table "horarios_paralelos" {
  "horario_paralelo_id" UUID [pk, default: `gen_random_uuid()`]
  "paralelo_id" UUID [not null]
  "aula_id" UUID
  "dia_semana" SMALLINT [not null]
  "hora_inicio" TIME [not null]
  "hora_fin" TIME [not null]
  "creado_at" TIMESTAMP [not null, default: `NOW()`]
}

Table "matriculas" {
  "matricula_id" UUID [pk, default: `gen_random_uuid()`]
  "estudiante_id" UUID [not null]
  "periodo_academico_id" UUID [not null]
  "numero_matricula" VARCHAR(50) [unique, not null]
  "estado" estado_matricula [not null, default: 'borrador']
  "presentada_at" TIMESTAMP
  "aprobada_por" UUID
  "aprobada_at" TIMESTAMP
  "observaciones" TEXT
  "creado_at" TIMESTAMP [not null, default: `NOW()`]
  "actualizado_at" TIMESTAMP [not null, default: `NOW()`]

  Indexes {
    (estudiante_id, periodo_academico_id) [unique, name: "uq_estudiante_periodo_matricula"]
    estudiante_id [name: "idx_matriculas_estudiante"]
    periodo_academico_id [name: "idx_matriculas_periodo"]
    estado [name: "idx_matriculas_estado"]
  }
}

Table "matricula_asignaturas" {
  "matricula_asignatura_id" UUID [pk, default: `gen_random_uuid()`]
  "matricula_id" UUID [not null]
  "paralelo_id" UUID [not null]
  "estado" estado_asignatura_matricula [not null, default: 'matriculado']
  "calificacion_final" NUMERIC
  "observacion_final" TEXT
  "retirada_at" TIMESTAMP
  "creado_at" TIMESTAMP [not null, default: `NOW()`]
  "actualizado_at" TIMESTAMP [not null, default: `NOW()`]

  Indexes {
    (matricula_id, paralelo_id) [unique, name: "uq_matricula_paralelo"]
    matricula_id [name: "idx_matricula_asignaturas_matricula"]
    paralelo_id [name: "idx_matricula_asignaturas_paralelo"]
    estado [name: "idx_matricula_asignaturas_estado"]
  }
}

Table "componentes_calificacion" {
  "componente_calificacion_id" UUID [pk, default: `gen_random_uuid()`]
  "paralelo_id" UUID [not null]
  "nombre" VARCHAR(150) [not null]
  "descripcion" TEXT
  "peso" NUMERIC [not null]
  "puntaje_maximo" NUMERIC [not null, default: 100]
  "fecha_entrega" DATE
  "indice_orden" INT [default: 1]
  "creado_at" TIMESTAMP [not null, default: `NOW()`]
  "actualizado_at" TIMESTAMP [not null, default: `NOW()`]

  Indexes {
    (paralelo_id, nombre) [unique, name: "uq_componente_paralelo_nombre"]
    paralelo_id [name: "idx_componentes_paralelo"]
  }
}

Table "calificaciones" {
  "calificacion_id" UUID [pk, default: `gen_random_uuid()`]
  "matricula_asignatura_id" UUID [not null]
  "componente_calificacion_id" UUID [not null]
  "puntaje" NUMERIC [not null]
  "retroalimentacion" TEXT
  "registrada_por" UUID [not null]
  "registrada_at" TIMESTAMP [not null, default: `NOW()`]
  "creado_at" TIMESTAMP [not null, default: `NOW()`]
  "actualizado_at" TIMESTAMP [not null, default: `NOW()`]

  Indexes {
    (matricula_asignatura_id, componente_calificacion_id) [unique, name: "uq_calificacion_por_componente"]
    matricula_asignatura_id [name: "idx_calificaciones_matricula_asignatura"]
    componente_calificacion_id [name: "idx_calificaciones_componente"]
  }
}

Table "sesiones_asistencia" {
  "sesion_asistencia_id" UUID [pk, default: `gen_random_uuid()`]
  "paralelo_id" UUID [not null]
  "fecha_clase" DATE [not null]
  "tema" VARCHAR(255)
  "creada_por" UUID
  "creado_at" TIMESTAMP [not null, default: `NOW()`]
  "actualizado_at" TIMESTAMP [not null, default: `NOW()`]

  Indexes {
    (paralelo_id, fecha_clase) [unique, name: "uq_sesion_asistencia"]
    paralelo_id [name: "idx_sesiones_asistencia_paralelo"]
  }
}

Table "registro_asistencia" {
  "registro_asistencia_id" UUID [pk, default: `gen_random_uuid()`]
  "sesion_asistencia_id" UUID [not null]
  "matricula_asignatura_id" UUID [not null]
  "estado" estado_asistencia [not null, default: 'presente']
  "observacion" TEXT
  "creado_at" TIMESTAMP [not null, default: `NOW()`]
  "actualizado_at" TIMESTAMP [not null, default: `NOW()`]

  Indexes {
    (sesion_asistencia_id, matricula_asignatura_id) [unique, name: "uq_registro_asistencia"]
    sesion_asistencia_id [name: "idx_registro_asistencia_sesion"]
    matricula_asignatura_id [name: "idx_registro_asistencia_matricula_asignatura"]
  }
}

Table "solicitudes_academicas" {
  "solicitud_academica_id" UUID [pk, default: `gen_random_uuid()`]
  "estudiante_id" UUID [not null]
  "tipo_solicitud" tipo_solicitud [not null]
  "matricula_id" UUID
  "matricula_asignatura_id" UUID
  "paralelo_id" UUID
  "descripcion" TEXT [not null]
  "estado" estado_solicitud [not null, default: 'pendiente']
  "revisada_por" UUID
  "revisada_at" TIMESTAMP
  "respuesta" TEXT
  "creado_at" TIMESTAMP [not null, default: `NOW()`]
  "actualizado_at" TIMESTAMP [not null, default: `NOW()`]

  Indexes {
    estudiante_id [name: "idx_solicitudes_estudiante"]
    estado [name: "idx_solicitudes_estado"]
    tipo_solicitud [name: "idx_solicitudes_tipo"]
  }
}

Table "documentos_estudiante" {
  "documento_estudiante_id" UUID [pk, default: `gen_random_uuid()`]
  "estudiante_id" UUID [not null]
  "tipo_documento" VARCHAR(100) [not null]
  "nombre_archivo" VARCHAR(255)
  "url_archivo" TEXT [not null]
  "estado" estado_documento [not null, default: 'pendiente']
  "revisado_por" UUID
  "revisado_at" TIMESTAMP
  "observacion" TEXT
  "cargado_at" TIMESTAMP [not null, default: `NOW()`]
  "creado_at" TIMESTAMP [not null, default: `NOW()`]
  "actualizado_at" TIMESTAMP [not null, default: `NOW()`]
}

Table "notificaciones" {
  "notificacion_id" UUID [pk, default: `gen_random_uuid()`]
  "usuario_id" UUID [not null]
  "titulo" VARCHAR(150) [not null]
  "mensaje" TEXT [not null]
  "estado" estado_notificacion [not null, default: 'no_leido']
  "leido_at" TIMESTAMP
  "creado_at" TIMESTAMP [not null, default: `NOW()`]
  "actualizado_at" TIMESTAMP [not null, default: `NOW()`]

  Indexes {
    usuario_id [name: "idx_notificaciones_usuario"]
    estado [name: "idx_notificaciones_estado"]
  }
}

Table "registros_auditoria" {
  "registro_auditoria_id" UUID [pk, default: `gen_random_uuid()`]
  "usuario_actor_id" UUID
  "accion" VARCHAR(100) [not null]
  "nombre_entidad" VARCHAR(100) [not null]
  "entidad_id" UUID
  "valores_anteriores" JSONB
  "valores_nuevos" JSONB
  "direccion_ip" VARCHAR(50)
  "agente_usuario" TEXT
  "creado_at" TIMESTAMP [not null, default: `NOW()`]

  Indexes {
    usuario_actor_id [name: "idx_registros_auditoria_actor"]
    (nombre_entidad, entidad_id) [name: "idx_registros_auditoria_entidad"]
    creado_at [name: "idx_registros_auditoria_creado_at"]
  }
}

Ref "fk_usuario_roles_usuario":"usuarios"."usuario_id" < "usuario_roles"."usuario_id" [delete: cascade]

Ref "fk_usuario_roles_rol":"roles"."rol_id" < "usuario_roles"."rol_id" [delete: cascade]

Ref "fk_rol_permisos_rol":"roles"."rol_id" < "rol_permisos"."rol_id" [delete: cascade]

Ref "fk_rol_permisos_permiso":"permisos"."permiso_id" < "rol_permisos"."permiso_id" [delete: cascade]

Ref "fk_carreras_facultad":"facultades"."facultad_id" < "carreras"."facultad_id"

Ref "fk_mallas_carrera":"carreras"."carrera_id" < "mallas_curriculares"."carrera_id"

Ref "fk_malla_asignaturas_malla":"mallas_curriculares"."malla_id" < "malla_asignaturas"."malla_id" [delete: cascade]

Ref "fk_malla_asignaturas_asignatura":"asignaturas"."asignatura_id" < "malla_asignaturas"."asignatura_id"

Ref "fk_prerrequisitos_asignatura":"asignaturas"."asignatura_id" < "prerrequisitos_asignaturas"."asignatura_id" [delete: cascade]

Ref "fk_prerrequisitos_prerrequisito":"asignaturas"."asignatura_id" < "prerrequisitos_asignaturas"."asignatura_prerrequisito_id" [delete: cascade]

Ref "fk_estudiantes_usuario":"usuarios"."usuario_id" < "estudiantes"."usuario_id" [delete: cascade]

Ref "fk_estudiantes_carrera":"carreras"."carrera_id" < "estudiantes"."carrera_id"

Ref "fk_estudiantes_malla":"mallas_curriculares"."malla_id" < "estudiantes"."malla_id"

Ref "fk_docentes_usuario":"usuarios"."usuario_id" < "docentes"."usuario_id" [delete: cascade]

Ref "fk_docentes_facultad":"facultades"."facultad_id" < "docentes"."facultad_id"

Ref "fk_personal_usuario":"usuarios"."usuario_id" < "personal_administrativo"."usuario_id" [delete: cascade]

Ref "fk_paralelos_asignatura":"asignaturas"."asignatura_id" < "paralelos"."asignatura_id"

Ref "fk_paralelos_periodo":"periodos_academicos"."periodo_academico_id" < "paralelos"."periodo_academico_id"

Ref "fk_paralelos_docente":"docentes"."docente_id" < "paralelos"."docente_id"

Ref "fk_horarios_paralelos_paralelo":"paralelos"."paralelo_id" < "horarios_paralelos"."paralelo_id" [delete: cascade]

Ref "fk_horarios_paralelos_aula":"aulas"."aula_id" < "horarios_paralelos"."aula_id"

Ref "fk_matriculas_estudiante":"estudiantes"."estudiante_id" < "matriculas"."estudiante_id"

Ref "fk_matriculas_periodo":"periodos_academicos"."periodo_academico_id" < "matriculas"."periodo_academico_id"

Ref "fk_matriculas_aprobada_por":"usuarios"."usuario_id" < "matriculas"."aprobada_por"

Ref "fk_matricula_asignaturas_matricula":"matriculas"."matricula_id" < "matricula_asignaturas"."matricula_id" [delete: cascade]

Ref "fk_matricula_asignaturas_paralelo":"paralelos"."paralelo_id" < "matricula_asignaturas"."paralelo_id"

Ref "fk_componentes_paralelo":"paralelos"."paralelo_id" < "componentes_calificacion"."paralelo_id" [delete: cascade]

Ref "fk_calificaciones_matricula_asignatura":"matricula_asignaturas"."matricula_asignatura_id" < "calificaciones"."matricula_asignatura_id" [delete: cascade]

